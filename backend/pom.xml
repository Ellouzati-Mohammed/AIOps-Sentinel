<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">


    <modelVersion>4.0.0</modelVersion>


    <!-- Parent Spring Boot -->
    <parent>

        <groupId>org.springframework.boot</groupId>

        <artifactId>
            spring-boot-starter-parent
        </artifactId>

        <version>4.0.7</version>

        <relativePath/>

    </parent>


    <!-- Informations du projet global -->

    <groupId>
        com.aiops
    </groupId>


    <artifactId>
        aiops-backend
    </artifactId>


    <version>
        1.0.0
    </version>


    <name>
        AIOps Sentinel Backend
    </name>


    <description>
        Backend microservices for AIOps Sentinel platform
    </description>


    <!-- Important :
         Ce n'est pas une application,
         c'est un projet parent
    -->

    <packaging>
        pom
    </packaging>



    <!-- Modules Microservices -->

    <modules>

        <module>
            auth-service
        </module>

        <!-- on ajoutera après -->

        <!--
        <module>
            gateway-service
        </module>

        <module>
            alert-service
        </module>

        <module>
            notification-service
        </module>
        -->

    </modules>



    <!-- Versions communes -->

    <properties>

        <java.version>
            17
        </java.version>


        <maven.compiler.source>
            17
        </maven.compiler.source>


        <maven.compiler.target>
            17
        </maven.compiler.target>


        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

    </properties>



    <!-- Plugins communs -->

    <build>

        <pluginManagement>

            <plugins>


                <!-- Spring Boot build -->

                <plugin>

                    <groupId>
                        org.springframework.boot
                    </groupId>

                    <artifactId>
                        spring-boot-maven-plugin
                    </artifactId>

                </plugin>


            </plugins>

        </pluginManagement>


    </build>


</project>